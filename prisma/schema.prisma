// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enum untuk role pengguna
enum Role {
  ADMIN
  TENANT // Penjual/Kreator
  BUYER // Pembeli
}

// Tabel Induk Pengguna (Login Credential)
model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean  @default(false)
  role               Role     @default(BUYER)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant    Tenant?
  purchases Transaction[]
}

// Profil Toko / Landing Page Utama (Tenant)
model Tenant {
  id            String    @id @default(uuid())
  userId        String    @unique
  username      String    @unique
  displayName   String
  bio           String?
  avatarUrl     String?
  qrCodeUrl     String?
  customDomain  String?   @unique
  seoConfig     Json?
  isPremium     Boolean   @default(false)
  premiumUntil  DateTime?
  walletBalance Float     @default(0)
  // Notifikasi Otomatis
  notifMethod   String    @default("EMAIL") // EMAIL | WHATSAPP | BOTH
  waPhoneNumber String?
  // Payment Gateway (Premium Only)
  pgProvider    String? // "MIDTRANS" | "XENDIT" | null
  pgApiKey      String? // Encrypted on deploy

  // Payhook / Direct Payment Integration (Premium Only)
  payhookTenantId      String?
  payhookApiKey        String?
  payhookWebhookSecret String?
  payhookQrisUrl       String?

  // KYC / Verifikasi Identitas
  kycStatus         String  @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  ktpName           String?
  ktpNumber         String?
  ktpImageUrl       String?
  kycRejectReason   String?


  bankName            String?
  bankAccount         String?
  bankAccountName     String?
  address             String?  @db.Text
  province            String?
  city                String?
  district            String?
  postalCode          String?
  latitude            Float?
  longitude           Float?
  originCityId        String?
  originSubdistrictId String?
  activeCouriers      Json?
  storageUsed         Float    @default(0) // Kapasitas penyimpanan terpakai dalam Bytes
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  pages              Page[]
  products           Product[]
  subscriptions      Subscription[]
  analyticsEvents    AnalyticsEvent[]
  leads              Lead[]
  orders             Order[]
  walletTransactions WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]
  whatsappLogs       WhatsappLog[]
  reviews            Review[]
  invitations        Invitation[]

  // Status Penangguhan (Suspend)
  isSuspended   Boolean @default(false)
  suspendReason String?
}

// Enum Tipe Halaman
enum PageType {
  BIO_LINK
  INVITATION
}

// Halaman yang dibuat Tenant
model Page {
  id          String   @id @default(uuid())
  tenantId    String
  slug        String // "index", "sale", "booking"
  type        PageType @default(BIO_LINK)
  title       String?
  themeConfig Json?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  blocks Block[]
}

// Tipe Blok/Widget
enum BlockType {
  LINK
  TEXT
  IMAGE
  VIDEO
  PRODUCT
  EXTERNAL_PRODUCT
  FORM_RSVP
  MAPS
  BOOKING
}

// Blok/Widget di dalam Halaman
model Block {
  id        String    @id @default(uuid())
  pageId    String
  type      BlockType
  order     Int
  content   Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  page Page @relation(fields: [pageId], references: [id])
}

// Katalog Produk (Fisik & Digital)
model Product {
  id          String  @id @default(uuid())
  tenantId    String
  title       String
  description String? @db.Text
  price       Float
  imageUrl    String?
  images      String[] @default([])

  isPhysical Boolean @default(false)
  weight     Int? // dalam gram
  stock      Int?
  sku        String?

  fileUrl String? // Untuk produk digital

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
  orderItems   OrderItem[]
}

// Riwayat Transaksi Produk Digital
model Transaction {
  id            String   @id @default(uuid())
  buyerId       String
  productId     String
  amount        Float
  status        String // PENDING, SUCCESS, FAILED
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  buyer   User    @relation(fields: [buyerId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// Riwayat Langganan Premium
model Subscription {
  id                 String    @id @default(uuid())
  tenantId           String
  plan               String // "MONTHLY" | "YEARLY"
  amount             Float
  status             String // "PENDING", "PAID", "FAILED"
  invoiceUrl         String?
  referenceId        String?
  paymentInstruction Json?
  createdAt          DateTime  @default(now())
  paidAt             DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// Analytics Event
model AnalyticsEvent {
  id        String   @id @default(uuid())
  tenantId  String
  type      String // "PAGE_VIEW" | "LINK_CLICK" | "PRODUCT_VIEW"
  targetId  String?
  userAgent String?
  ipHash    String?
  referrer  String?
  country   String?
  city      String?
  device    String?
  os        String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// Data Lead: Booking / RSVP / Form
model Lead {
  id           String    @id @default(uuid())
  tenantId     String
  blockId      String
  source       String    @default("BOOKING") // BOOKING | RSVP | FORM | CONTACT
  name         String
  phone        String?
  email        String?
  bookingDate  DateTime?
  bookingTime  String?
  notes        String?
  internalNote String? // Catatan internal penjual
  status       String    @default("NEW") // NEW | FOLLOW_UP | CONFIRMED | COMPLETED | CANCELLED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// Order dari Pembeli (Guest Checkout) — Multi-Item
model Order {
  id              String   @id @default(uuid())
  tenantId        String
  orderNumber     String   @unique
  customerName    String
  customerPhone   String // No WA pembeli
  customerEmail   String?
  shippingAddress String?
  shippingCost    Float    @default(0)
  notes           String? // Catatan dari pembeli
  internalNote    String? // Catatan internal penjual
  grandTotal      Float
  platformFee     Float    @default(0)
  netAmount       Float
  channel         String   @default("DIRECT") // DIRECT | SHOPEE | TOKOPEDIA | WHATSAPP
  status          String   @default("PENDING") // PENDING | PAID | PROCESSING | SHIPPED | DELIVERED | COMPLETED | CANCELLED
  paymentMethod   String?
  paymentGateway  String? // MANUAL | PAYHOOK_GLOBAL | PAYHOOK_DEDICATED
  paymentLink     String?
  paymentProof    String? // URL bukti pembayaran manual
  awbNumber       String? // Nomor Resi
  courier         String? // Nama Ekspedisi
  waSent          Boolean  @default(false)

  // Anti-fraud / Evidence
  sellerPackingVideoUrl  String?
  buyerUnboxingVideoUrl  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  items  OrderItem[]
  review Review?
}

// Item per Order
model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  productId     String? // Relasi opsional ke Product
  blockId       String? // Opsional: block bisa dihapus tapi data tetap ada
  productName   String
  imageUrl      String?
  price         Float
  quantity      Int
  subtotal      Float // price * quantity
  isDigital     Boolean @default(false)
  digitalFileId String? // ID file dari Google Drive

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// Riwayat Mutasi Saldo Wallet (Ledger)
model WalletTransaction {
  id          String   @id @default(uuid())
  tenantId    String
  type        String // "CREDIT" | "DEBIT"
  amount      Float
  description String
  referenceId String?
  status      String   @default("SUCCESS") // SUCCESS | PENDING
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// Permintaan Tarik Dana (Withdrawal)
model WithdrawalRequest {
  id              String   @id @default(uuid())
  tenantId        String
  amount          Float // Nominal kotor yang ditarik
  fee             Float // Biaya platform + beda bank
  netAmount       Float // Nominal bersih yang ditransfer admin
  bankName        String
  bankAccount     String
  bankAccountName String
  status          String   @default("PENDING") // PENDING | COMPLETED | REJECTED
  proofUrl        String? // Bukti transfer dari admin
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// Sistem Tiket & Laporan (Support & Report)
model Ticket {
  id          String   @id @default(uuid())
  senderEmail String
  senderName  String
  subject     String
  message     String
  status      String   @default("OPEN") // OPEN | RESOLVED | CLOSED
  type        String   @default("SUPPORT") // SUPPORT (dari user) | REPORT_STORE (dari publik)
  targetId    String? // ID Tenant yang dilaporkan (jika type = REPORT_STORE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Konfigurasi Global Sistem (Admin Only)
model SystemConfig {
  key       String   @id // e.g., "WHATSAPP_SYSTEM_ENABLED"
  value     String // e.g., "true", "false"
  updatedAt DateTime @updatedAt
}

// Riwayat Pengiriman WhatsApp (Monitoring)
model WhatsappLog {
  id        String   @id @default(uuid())
  tenantId  String? // null berarti ini pesan Sistem (Platform)
  orderId   String? // Jika terkait dengan suatu pesanan
  phone     String // Nomor tujuan
  message   String // Isi teks
  sentBy    String // "SYSTEM" | "TENANT"
  status    String // "SUCCESS" | "FAILED"
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
}

// Ulasan Pembeli (Verified Purchase)
model Review {
  id        String   @id @default(uuid())
  tenantId  String
  orderId   String   @unique
  rating    Int // 1 to 5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// SISTEM UNDANGAN DIGITAL (DIGITAL INVITATION)
// ----------------------------------------------------

model Invitation {
  id          String   @id @default(uuid())
  tenantId    String
  slug        String   @unique // URL Unik: tuppy.my.id/undangan/[slug]
  themeId     String   @default("theme-classic")
  animation   String   @default("sakura")
  title       String // e.g., "Pernikahan Romeo & Juliet"
  
  // Data JSON (Mempelai, Acara, Amplop, Galeri)
  groom       Json?    
  bride       Json?
  events      Json?
  banks       Json?
  gallery     Json?
  
  // Custom Media
  musicUrl      String?
  backgroundUrl String?
  qrisImage     String?
  
  // Custom Design (Fonts & Colors)
  design        Json?
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guests      InvitationGuest[]
}

model InvitationGuest {
  id           String   @id @default(uuid())
  invitationId String
  name         String
  phone        String?
  status       String   @default("Belum Dikirim") // Belum Dikirim | Sudah Dikirim
  rsvpStatus   String?  // Hadir | Tidak Hadir | Ragu
  rsvpMessage  String?  @db.Text
  guestsCount  Int?     @default(1)
  createdAt    DateTime @default(now())

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model InvitationMusic {
  id        String   @id @default(uuid())
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvitationBackground {
  id        String   @id @default(uuid())
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

